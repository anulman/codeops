    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@playwright/mcp": "0.0.82",
    "@types/node": "25.7.0",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.5.0",
    "typescript": "6.0.3",
    "zod": "4.3.6"
  }
